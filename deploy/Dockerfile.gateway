FROM node:20-alpine AS backoffice-builder

WORKDIR /app/finventory-ui

COPY finventory-ui/package*.json ./
RUN npm ci

COPY finventory-ui/ ./

ARG BACKOFFICE_API_URL=/api/v1
ENV VITE_API_URL=${BACKOFFICE_API_URL}
ENV VITE_BASE_PATH=/inventory/

RUN npm run build

FROM node:20-alpine AS storefront-builder

WORKDIR /app/storefront-ui

COPY storefront-ui/package*.json ./
RUN npm ci

COPY storefront-ui/ ./

ARG STOREFRONT_API_URL=/api/v1
ENV VITE_API_URL=${STOREFRONT_API_URL}

RUN npm run build

FROM caddy:2.8.4-alpine

COPY finventory-ui/deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=storefront-builder /app/storefront-ui/dist /srv/storefront
COPY --from=backoffice-builder /app/finventory-ui/dist /srv/inventory
COPY finventory-ui/deploy/landing /srv/landing
